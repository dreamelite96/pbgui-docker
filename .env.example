# .env.example — Copy this file to .env and adjust values to your needs.
# docker-compose.yml reads from .env automatically; all values below are the
# defaults used when .env is absent or a variable is left unset.

# ── Container identity ────────────────────────────────────────────────────────
# Local image name used to tag the built image (no registry push assumed).
PBGUI_IMAGE_NAME=pbgui-docker
PBGUI_IMAGE_TAG=latest
PBGUI_CONTAINER_NAME=pbgui

# ── User and Group ID ─────────────────────────────────────────────────────────
# Host user UID and GID mapped inside the container for bind-mounted volumes.
# Matches host permissions to avoid permission errors. Defaults to 1000:1000.
PBGUI_UID=1000
PBGUI_GID=1000

# ── Ports ─────────────────────────────────────────────────────────────────────
# Host-side port mapped to the container's FastAPI Web UI & API (port 8000).
# Change this if port 8000 is already in use on your host.
PBGUI_WEBUI_PORT=8000

# ── Resource limits ───────────────────────────────────────────────────────────
# Adjust to match your host hardware.  Memory accepts Docker size strings
# (e.g. 4096M, 4g).  CPU is expressed as a fractional number of cores.
PBGUI_CPU_LIMIT=4
PBGUI_MEMORY_LIMIT=8192M

# ── Component git versions (commits / branches) ───────────────────────────────
# Downloaded strictly from official GitHub repositories:
#   PBGui: https://github.com/msei99/pbgui.git
#   Passivbot: https://github.com/enarjord/passivbot.git
PBGUI_COMMIT=37942d20e4670e2c97c5477ec0af413a6e94a294
PB7_COMMIT=fc6b9e016e04a3723bb5fe8847f1500049fa982c
PB8_COMMIT=a0897f83932db5e6888c1c96f8f1c668d452013f

